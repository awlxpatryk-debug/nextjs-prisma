generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String   // Dodane hasło
  name        String?
  role        String   @default("KIEROWCA") 
  permissions Json     @default("{}")       
}

model Rack {
  id             String   @id @default(cuid())
  qrCode         String   @unique
  status         String   @default("MAGAZYN") 
  type           String   @default("L-FRAME")
  lengthFull     Float    @default(1.2) 
  lengthEmpty    Float    @default(0.2) 
}